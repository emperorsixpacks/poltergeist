{
  "manifest_version": 3,
  "name": "Poltergeist",
  "version": "1.0.0",
  "description": "A mischievous ghost that haunts the web page you're reading. Built for Hacktoberfest: Ghost in the Machine.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Poltergeist",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["content.css", "assets.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
